  <h1>SLOP1521: 2026 Final Exam</h1>
  <section class="course-specsheet" aria-label="Paper details">
    <dl>
      <dt>Course</dt>
      <dd>SLOP1521 — Introduction to Life: Foundations of Being a Person</dd>
      <dt>Session</dt>
      <dd>Semester 1, 2026</dd>
      <dt>Candidate name</dt>
      <dd>_______________________________</dd>
      <dt>Student ID</dt>
      <dd>_______________________________</dd>
