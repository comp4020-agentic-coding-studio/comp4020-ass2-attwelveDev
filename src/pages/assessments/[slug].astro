---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import EntryNav from "../../components/EntryNav.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDateTime } from "../../lib/dates";
import { assessmentNavLabel, neighbors, sortedAssessments } from "../../lib/entry-order";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);

const assessments = await sortedAssessments();
const { previous, next } = neighbors(assessments, assessment.id);
const previousLabel = previous && assessmentNavLabel(previous.data.title);
const nextLabel = next && assessmentNavLabel(next.data.title);
const currentLabelParts = assessmentNavLabel(assessment.data.title);
const currentLabel = currentLabelParts.subtitle
  ? `${currentLabelParts.primary}: ${currentLabelParts.subtitle}`
  : currentLabelParts.primary;
---

<ContentLayout
  title={assessment.data.title}
  description={assessment.data.description}
  {...siteConfig}
>
  <EntryNav
    previous={previous && {
      href: withBase(`/assessments/${previous.id}/`),
      primaryLabel: previousLabel?.primary ?? previous.data.title,
      subtitleLabel: previousLabel?.subtitle,
    }}
    next={next && {
      href: withBase(`/assessments/${next.id}/`),
      primaryLabel: nextLabel?.primary ?? next.data.title,
      subtitleLabel: nextLabel?.subtitle,
    }}
    currentLabel={currentLabel}
  />
  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  <section class="course-specsheet" aria-label="Assessment details">
    <dl>
      <dt>Due</dt>
      <dd>
        {assessment.data.dueDisplay ?? formatCourseDateTime(assessment.data.due)}
        {assessment.data.dueWeekLabel && `, ${assessment.data.dueWeekLabel}`}
      </dd>
      <dt>Weight</dt>
      <dd>{assessment.data.weight}%</dd>
      <dt>Content scope</dt>
      <dd>{assessment.data.contentScope.display}</dd>
    </dl>
  </section>
  <Content />
  <SpecList spec={assessment.data.spec}>
    The brief poses the problem and leaves room for a response. The spec is the
    fixed part: what a marker checks. Some lines can be checked mechanically;
    the rest call for judgement.
  </SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
</ContentLayout>
