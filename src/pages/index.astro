---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const destinations = [
  {
    title: "Lectures",
    href: "/lectures/",
    description: "What is covered, week by week, and which topics each lecture draws on.",
  },
  {
    title: sessionLabels.plural,
    href: "/sessions/",
    description: "The twelve-week teaching schedule: what happens in each lab, what to prepare, and what leaves the room.",
  },
  {
    title: "Assessment",
    href: "/assessments/",
    description: "Every piece of graded work in the course, what it is worth, and when it is due.",
  },
  {
    title: "People",
    href: "/people/",
    description: "Who teaches the course and how to reach them.",
  },
];
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A person reclining with headphones on beside a cluttered office desk — an old monitor, a tissue box, a mug, scattered papers — eyes closed, mid-shift"
  {...siteConfig}
>
  <p class="hero-credit">
    Hero photo: "Zoning at the office" by{" "}
    <a href="https://www.flickr.com/photos/sfllaw/5892567/">Simon Law</a>,
    licensed{" "}
    <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC BY-SA 2.0</a>.
  </p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="thesis">
    <strong>
      Competence is a skill like any other. CS culture just never taught you
      this one.
    </strong>
  </p>

  <h2>What this course is</h2>
  <p>
    SLOP1521 covers the material a computer science degree assumes you
    picked up somewhere else: sleep, hygiene, dress, conversation, money,
    and how to behave in front of another human being. Each topic is
    treated as a real subject, with real assessment, because — department
    opinion notwithstanding — it is one. The semester concludes with a
    five-station practical examination covering hygiene and health,
    fashion, small talk, reading the room and daily survival.
  </p>

  <h2>Who this course is for</h2>
  <p>
    Anyone who has eaten the same bowl of instant noodles four nights
    running and called it meal planning. Anyone whose last haircut
    predates their current degree. No prior experience assumed; a working
    knowledge of at least one hoodie is expected.
  </p>

  <h2>Learning outcomes</h2>
  <p>By the end of the semester, you will be able to:</p>
  <ol>
    {courseMeta.learningOutcomes.map((outcome, index) => (
      <li id={`lo-${index + 1}`}>{outcome}</li>
    ))}
  </ol>

  <h2>Where to go next</h2>
  <ul class="course-list">
    {
      destinations.map((destination) => (
        <li>
          <h3>
            <a href={withBase(destination.href)}>{destination.title}</a>
          </h3>
          <p>{destination.description}</p>
        </li>
      ))
    }
  </ul>
</ContentLayout>

<style>
  .hero-credit {
    margin-block-start: -0.5rem;
    margin-block-end: var(--at-spacing-xl);
    font-size: var(--at-font-size-xs);
    font-style: italic;
    color: var(--at-text-secondary);
  }
</style>
