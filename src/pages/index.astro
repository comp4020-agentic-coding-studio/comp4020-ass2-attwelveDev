---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const destinations = [
  {
    title: sessionLabels.plural,
    href: "/sessions/",
    description: "The weekly schedule and what happens in each teaching session.",
  },
  {
    title: "Assessment",
    href: "/assessments/",
    description: "What is marked, what it is worth, and when it is due.",
  },
  {
    title: "People",
    href: "/people/",
    description: "Who teaches the course and how to reach them.",
  },
];
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A corridor of gold status-grid floor tiles, a few flagged black for maintenance, receding toward a lit doorway, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="thesis">
    <strong>
      Competence is a skill like any other. CS culture just never taught you
      this one.
    </strong>
  </p>

  <h2>What this course is</h2>
  <p>
    SLOP1521 applies systems engineering to the parts of being a person that a
    computer science degree usually assumes you have already handled: sleep,
    hygiene, dress, conversation, money and professional conduct. Each week
    treats one <code>subsystem</code> as a system — schedule it, monitor it,
    find the <code>root cause</code> when it fails — and the semester ends in
    a five-station practical examination covering hygiene and health,
    fashion, small talk, social debugging and daily survival.
  </p>

  <h2>Who this course is for</h2>
  <p>
    Anyone whose personal systems have been running on <code>manual
    override</code> since high school and would like a maintenance
    schedule instead. No prior experience assumed; some regressions
    expected.
  </p>

  <h2>Learning outcomes</h2>
  <p>By the end of the semester, you will be able to:</p>
  <ul>
    {courseMeta.learningOutcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>

  <h2>Where to go next</h2>
  <ul class="course-list">
    {
      destinations.map((destination) => (
        <li>
          <h3>
            <a href={withBase(destination.href)}>{destination.title}</a>
          </h3>
          <p>{destination.description}</p>
        </li>
      ))
    }
  </ul>
</ContentLayout>
