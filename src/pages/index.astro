---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

// STARTER_CONTENT: replace the hero artwork and its alt text below, then
// remove this comment.
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p class="thesis">
    <strong>
      Competence is a skill like any other. CS culture just never taught you
      this one.
    </strong>
  </p>

  <h2>What this course is</h2>
  <p>
    SLOP1521 applies systems engineering to the parts of being a person that a
    computer science degree usually assumes you have already handled: sleep,
    hygiene, dress, conversation, money and professional conduct. Each week
    treats one subsystem as a system — schedule it, monitor it, find the root
    cause when it fails — and the semester ends in a five-station practical
    examination covering hygiene and health, fashion, small talk, social
    debugging and daily survival.
  </p>

  <h2>Who this course is for</h2>
  <p>
    Anyone whose personal systems have been running on manual override since
    high school and would like a maintenance schedule instead. No prior
    experience assumed; some regressions expected.
  </p>

  <h2>Learning outcomes</h2>
  <p>By the end of the semester, you will be able to:</p>
  <ul>
    {courseMeta.learningOutcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
