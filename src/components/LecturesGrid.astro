---
import { getPublishedCollection } from "astro-course-university/content";
import Icon from "astro-theme-university/components/Icon.astro";
import { withBase } from "astro-theme-university/url";
import TopicChips from "./TopicChips.astro";
import { formatCourseDate } from "../lib/dates";
import { extractContentTopics } from "../lib/topics";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<div class="course-schedule">
  <table>
    <thead>
      <tr>
        <th scope="col">Week</th>
        <th scope="col">Date</th>
        <th scope="col">Title</th>
        <th scope="col">Topics</th>
        <th scope="col">Slides</th>
      </tr>
    </thead>
    <tbody>
      {
        visible.map((lecture) => (
          <tr>
            <td>{lecture.data.week}</td>
            <td>{formatCourseDate(lecture.data.date)}</td>
            <td>
              <a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a>
            </td>
            <td>
              <TopicChips topics={extractContentTopics(lecture.body ?? "")} />
            </td>
            <td>
              {lecture.data.slides && (
                <a
                  class="at-icon-button"
                  href={withBase(lecture.data.slides)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open slides for Week ${lecture.data.week}`}
                >
                  <Icon name="presentation" />
                </a>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
