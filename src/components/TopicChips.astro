---
import { truncateTopic } from "../lib/topics";

interface Props {
  topics: string[];
}

const { topics } = Astro.props;
---

<ul class="course-topics">
  {
    topics.map((topic) => (
      <li class="course-topic">
        {truncateTopic(topic).map((segment) =>
          segment.code ? <code>{segment.text}</code> : segment.text,
        )}
      </li>
    ))
  }
</ul>
