---
import Icon from "astro-theme-university/components/Icon.astro";

export interface EntryNavItem {
  href: string;
  primaryLabel: string;
  subtitleLabel?: string;
}

interface Props {
  previous?: EntryNavItem;
  next?: EntryNavItem;
  currentLabel: string;
}

const { previous, next, currentLabel } = Astro.props;
---

<nav class="week-nav" aria-label="Page navigation">
  <div class="week-nav-inner">
    <div class="week-nav-side week-nav-side--prev">
      {
        previous && (
          <a class="week-nav-link" href={previous.href}>
            <Icon name="nav-arrow-left" class="week-nav-icon" />
            <span class="week-nav-text">
              <span class="week-nav-title">{previous.primaryLabel}</span>
              {previous.subtitleLabel && (
                <span class="week-nav-subtitle">{previous.subtitleLabel}</span>
              )}
            </span>
          </a>
        )
      }
    </div>
    <p class="week-nav-current" data-week-nav-current>
      {currentLabel}
    </p>
    <div class="week-nav-side week-nav-side--next">
      {
        next && (
          <a class="week-nav-link" href={next.href}>
            <span class="week-nav-text">
              <span class="week-nav-title">{next.primaryLabel}</span>
              {next.subtitleLabel && <span class="week-nav-subtitle">{next.subtitleLabel}</span>}
            </span>
            <Icon name="nav-arrow-right" class="week-nav-icon" />
          </a>
        )
      }
    </div>
  </div>
</nav>

<style>
  .week-nav {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 90;
    /* No background here: course.css supplies the translucent, blurred one.
       Astro scopes this style with a data-astro-cid-* attribute selector,
       which is *more specific* than course.css's plain .week-nav rule —
       course.css being unlayered only lets it beat the theme's own layered
       rules, not this component's own higher-specificity one. A background
       declared here would silently win and paint over the blur. */
    border-block-start: 1px solid var(--at-divider);
  }

  .week-nav-inner {
    /* .week-nav itself is intentionally full-viewport-width (position:
       fixed, inset-inline: 0) so its background/blur reach the edges like
       the site nav's does — this re-centers the actual nav content to a
       fixed row width, decoupled from the reading column's own (more
       complex) formula, matching .at-nav-inner's own established
       precedent in course.css for exactly this "nav row, not reading
       measure" situation. */
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--at-spacing-md);
    padding-block: var(--at-spacing-sm);
  }

  .week-nav-side {
    flex: 1 1 0;
    display: flex;
  }

  .week-nav-side--next {
    justify-content: flex-end;
  }

  .week-nav-link,
  .week-nav-link:visited {
    display: inline-flex;
    align-items: center;
    gap: var(--at-spacing-xs);
    text-decoration: none;
    color: inherit;
  }

  .week-nav-icon {
    /* Without this, a tight row (a long center label competing for the
       same space) shrinks the icon down to a few px before it touches
       the already-capped title text at all — flex items shrink by
       default, and an icon has no natural minimum size of its own. */
    flex-shrink: 0;
  }

  .week-nav-side--next .week-nav-link {
    text-align: right;
  }

  .week-nav-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .week-nav-title {
    font-weight: 600;
  }

  .week-nav-subtitle {
    font-size: var(--at-font-size-sm);
    color: var(--at-text-muted);
  }

  .week-nav-current {
    /* max-width: 50% is constant — the same whether this is hidden or
       showing, never toggled by ".is-visible". An earlier version
       reserved 0 width while hidden and only 50% once visible: that
       meant the amount of room left for the side "Week N"/subtitle
       text was itself different in the two states, so revealing the
       label could force the sides to reflow (a subtitle that fit on one
       line before scrolling wrapping to two once the label appeared) —
       a resize nobody asked for, on top of the intended fade. Reserving
       the same width at all times means only opacity/transform (both
       compositor-only, no layout impact) ever change on scroll — the
       sides never reflow because scrolling changed. */
    flex: 0 1 auto;
    min-width: 0;
    max-width: 50%;
    margin: 0;
    text-align: center;
    overflow-wrap: break-word;
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .week-nav-current.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (width <= 768px) {
    .week-nav-subtitle {
      display: none;
    }

    /* On mobile the center label is always in the DOM (only opacity
       toggles), and once revealed it should show its full text rather
       than being cut to one line — but it's also squeezed to a much
       narrower box while the side "Week N" labels are still showing
       (below) than once they collapse, and that squeeze happens whether
       or not the label is currently visible. Left to wrap freely, that
       would mean a different number of lines — and a different footer
       height — depending on which state the header is in.
       A flat "always reserve two lines" fixed height would solve that,
       but it wastes visible footer space on the many titles ("Assignment
       1: Makeover") that only need one. Instead the script below measures
       this page's *specific* label once, at the width it will actually
       have once revealed, and writes that exact pixel value into
       --week-nav-current-height — so the reserved height matches this
       page's real content and, because it's fixed rather than
       recalculated on scroll, never changes between states. The
       calc(2 * 1.4em) here only covers the brief window before that
       script runs (or a no-JS fallback); -webkit-line-clamp is a safety
       net for the rare title too long even at full width, not the
       primary sizing mechanism. line-height is set explicitly (rather
       than left to the page default) so both the fallback and the
       script's own measurement agree on what "a line" is. */
    .week-nav-current {
      /* flex-grow stays 0 (inherited from the base rule) so this never
         competes with the sides' own flex-grow: 1 for space — it was
         briefly set to grow here, which let it claim enough of the row
         that the arrow icons (flex-shrink: 0 on the icon itself doesn't
         help if the icon's own flex container is squeezed away from
         under it) lost their space and rendered shrunk. max-width is
         still overridden, from the base rule's 50% up to nearly the
         full row — reserving just 5rem for the two arrow icons, their
         icon-to-text gaps, and the row's own two gaps (a fixed cost
         whether or not "Week N" text is currently showing next to the
         icon), so the label actually gets to use the room freed up once
         "Week N" collapses instead of still being capped at half the
         row. */
      max-width: calc(100% - 5rem);
      line-height: 1.4;
      height: var(--week-nav-current-height, calc(2 * 1.4em));
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-box-pack: center;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    /* Because the center label's height is now fixed regardless of how
       squeezed it gets (above), "Week N" is free to keep enough width to
       show labels like "Assignment 2" in full instead of being clipped
       mid-word — the old 5rem budget was sized for short "Week N" labels
       and truncated anything longer. Ellipsis is still here as a
       fallback for the rare longer title ("Weekly Reflections") that
       doesn't fit even this wider budget. */
    .week-nav-title {
      max-width: 9.5rem;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      /* max-width's own transition is 0s (an instant snap, not an
         animation) — width is deliberately never eased, since animating
         it is what caused the earlier reflow jank — but it still carries
         the same 200ms *delay* as opacity below, and that delay is load-
         bearing: .week-nav-side sizes itself to this element's actual
         content (flex: 0 0 auto, see below), so the instant this snaps
         back to 9.5rem, the side box claims that width too, squeezing
         the still-fading-out center label into a narrower box mid-fade —
         visually, its text visibly shrinking a beat before it finishes
         disappearing. Delaying the snap until the center label's own
         200ms fade-out has fully finished (at which point the center is
         invisible anyway) removes that squeeze entirely instead of just
         timing it to be less noticeable.
         The delay on opacity itself is a separate, cosmetic concern: a
         same-duration, undelayed opacity fade on both this and the
         center label crossfades correctly in principle, but for a good
         chunk of that shared 200ms both are simultaneously at a high,
         clearly-legible opacity — which reads as "both visible at once"
         even though nothing is actually stuck or flickering. Delaying
         this element's reappearance until *after* the center label's own
         200ms fade-out has fully finished means at most one of the two
         is ever meaningfully visible at a time — sequenced, not
         overlapped. (The other direction — becoming hidden, below —
         needs no delay on either property: freeing the width and
         starting the fade-in both begin immediately, and nobody reported
         an issue with that direction.) */
      opacity: 1;
      transition:
        opacity 200ms ease 200ms,
        max-width 0s linear 200ms;
    }

    .week-nav.is-scrolled .week-nav-title {
      max-width: 0;
      opacity: 0;
      transition: opacity 200ms ease;
    }

    /* A fixed min-width sized to the longest realistic title (as this
       used to be) reserves that width on *both* sides unconditionally,
       even for a short neighbor like "Assignment 3" that only needs a
       fraction of it — with two of those floors plus the row's own gaps,
       the total could exceed the viewport outright, pushing the far side
       clean off-screen (its arrow included) rather than just wasting
       space. flex: 0 0 auto instead sizes each side to *its own* actual
       content — icon + gap + however wide this page's specific "Week N"
       text is, up to .week-nav-title's own max-width — so the two sides
       together only ever claim what they actually need. flex-shrink: 0
       is the part that matters most: it's what stops the center label's
       max-width (above) from squeezing this box (and clipping its title
       text) even before the title's own max-width has finished collapsing
       to 0, so the icon — anchored to the row's own outer edge by
       .week-nav-inner's space-between regardless of this box's width —
       never has less room than it needs and never has to move. */
    .week-nav-side {
      flex: 0 0 auto;
    }
  }
</style>

<script>
  // Astro's ClientRouter does soft (client-side) navigation between pages,
  // and only re-runs this script on "astro:page-load" — which also fires
  // once for the very first real page load, so it's the only hook needed
  // (same pattern as this theme's Nav.astro/Footer.astro). Without it, the
  // observer set up on the first page in a browsing session would keep
  // watching that page's now-detached <h1> after navigating elsewhere, and
  // the new page's label would never get its own observer.
  let observer: IntersectionObserver | undefined;
  let resizeHandler: (() => void) | undefined;

  // The center label's box height is pinned (--week-nav-current-height,
  // consumed by .week-nav-current in the mobile media query) so it can't
  // change across the scroll boundary — see that rule's own comment for
  // why. This measures what that height actually needs to be for *this
  // page's* label text, at the width it will have once revealed (sides
  // collapsed), regardless of how squeezed it is right now. Taking it out
  // of flow with position: fixed (rather than measuring it in place) means
  // the current, possibly-narrower flex-squeezed width has no influence on
  // the measurement, and reverting the inline style before anything else
  // reads layout means the browser never has a reason to paint the
  // in-between state.
  function measureCurrentLabelHeight(currentLabel: HTMLElement): number {
    const originalStyle = currentLabel.getAttribute("style");
    Object.assign(currentLabel.style, {
      position: "fixed",
      visibility: "hidden",
      height: "auto",
      width: "calc(100% - 5rem)",
      webkitLineClamp: "unset",
    });
    const measured = currentLabel.scrollHeight;
    if (originalStyle === null) {
      currentLabel.removeAttribute("style");
    } else {
      currentLabel.setAttribute("style", originalStyle);
    }
    return measured;
  }

  function setupWeekNav() {
    observer?.disconnect();
    if (resizeHandler) window.removeEventListener("resize", resizeHandler);

    const weekNav = document.querySelector<HTMLElement>(".week-nav");
    const currentLabel = document.querySelector<HTMLElement>("[data-week-nav-current]");
    // Every page this component renders on (Lecture/Lab/Assessment/Person)
    // has exactly one <h1> — either ContentLayout's own, or Hero's
    // ".at-hero-title" when the page has a hero image (People only).
    const heading = document.querySelector<HTMLElement>("h1");

    if (!weekNav || !currentLabel || !heading) return;

    // Reset explicitly: a soft navigation morphs the DOM rather than
    // rebuilding it from scratch, so a class added by client JS on the
    // previous page can otherwise survive onto the new page's markup.
    currentLabel.classList.remove("is-visible");
    weekNav.classList.remove("is-scrolled");

    // Re-measured on resize too: rotating a phone or resizing dev tools
    // changes how many words fit per line, and the *fallback* two-line
    // height in the CSS could otherwise persist as stale, wrong sizing
    // caught mid-way between two real content heights.
    const applyHeight = () => {
      weekNav.style.setProperty(
        "--week-nav-current-height",
        `${measureCurrentLabelHeight(currentLabel)}px`,
      );
    };
    applyHeight();
    resizeHandler = applyHeight;
    window.addEventListener("resize", resizeHandler);

    // .week-nav is a fixed footer now, always on screen — the center label
    // only needs to repeat the page's own title once that title (<h1>) has
    // scrolled out of view; while it's still visible there's nothing to
    // stand in for. The top nav bar is sticky and covers a fixed strip at
    // the very top of the viewport, so "out of view" means past *that*
    // strip, not past the bare viewport edge — same idea as this
    // component's own sticky offset used to need, just measured off the
    // top nav's actual rendered height instead of a CSS property read off
    // this component's own now-fixed (not sticky) position.
    const topNav = document.querySelector<HTMLElement>(".at-nav");
    const coveredHeight = topNav?.getBoundingClientRect().height ?? 0;

    // A single fixed threshold flickers on real (touch/trackpad) scrolling:
    // a hand isn't perfectly still, so a hold that lands within a pixel or
    // two of the exact boundary can cross it back and forth several times,
    // restarting the opacity transition each time and never letting it
    // settle — visually, the center label and "Week N" both stuck at some
    // mid-fade blend indefinitely. HYSTERESIS_PX makes leaving a state
    // require a *bit more* scroll than entering it, so a small hover right
    // at the boundary can't retrigger the toggle.
    const HYSTERESIS_PX = 12;
    let revealed = false;

    const watch = () => {
      observer?.disconnect();
      // While hidden, require scrolling a bit *past* the covered strip
      // before revealing (a smaller excluded margin — harder to trigger).
      // While revealed, require scrolling a bit *back past* it the other
      // way before hiding again (a larger excluded margin — also harder to
      // trigger). The dead zone between the two is where a shaky hold
      // can't flip the state at all.
      const margin = revealed ? coveredHeight + HYSTERESIS_PX : coveredHeight - HYSTERESIS_PX;
      observer = new IntersectionObserver(
        ([entry]) => {
          const nowRevealed = !entry.isIntersecting;
          if (nowRevealed === revealed) return;
          revealed = nowRevealed;
          currentLabel.classList.toggle("is-visible", revealed);
          // On narrow viewports, the side "Week N" labels only need to
          // give up their room to the center label once it's showing.
          weekNav.classList.toggle("is-scrolled", revealed);
          watch();
        },
        { rootMargin: `-${Math.max(0, Math.ceil(margin))}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(heading);
    };

    watch();
  }

  document.addEventListener("astro:page-load", setupWeekNav);
</script>
