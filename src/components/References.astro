---
interface Citation {
  text: string;
  note?: string;
}

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;
---

{
  citations.length > 0 && (
    <section aria-labelledby="references">
      <h2 id="references">References</h2>
      <ul class="course-list">
        {citations.map((citation) => (
          <li>
            {citation.text}
            {citation.note && <span class="course-citation-note"> {citation.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}
