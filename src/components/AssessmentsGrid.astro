---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.week - b.data.week);
---

<ul class="course-list">
  {
    visible.map((assessment) => (
      <li>
        <h2>
          <a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a>
        </h2>
        {assessment.data.description && <p>{assessment.data.description}</p>}
        {assessment.data.weight != null && (
          <p>
            <small>
              Due {formatCourseDate(assessment.data.due)} · Weight: {assessment.data.weight}%
              {assessment.data.draft && " · Draft"}
            </small>
          </p>
        )}
      </li>
    ))
  }
</ul>
