---
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import { sortedSessions } from "../lib/entry-order";

const visible = await sortedSessions();
---

<div class="course-schedule">
  <table>
    <thead>
      <tr>
        <th scope="col">Week</th>
        <th scope="col">Date</th>
        <th scope="col">Title</th>
        <th scope="col">Description</th>
      </tr>
    </thead>
    <tbody>
      {
        visible.map((session) => (
          <tr>
            <td>{session.data.week}</td>
            <td>{formatCourseDate(session.data.date)}</td>
            <td>
              <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
            </td>
            <td>{session.data.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
